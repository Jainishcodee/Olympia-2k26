rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit logs collection
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Public read, admin write collections
    match /sports/{sportId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /displayConfigs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /leaderboards/{sportId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Authoritative Match Document
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();

      // Canonical match events stream
      match /events/{eventId} {
        allow read: if true;
        allow write: if isAdmin();

        // Event-specific spectator reactions
        match /reactions/{uid} {
          allow read: if true;
          allow create, update: if isAuthenticated();
          allow delete: if isAdmin();
        }
      }

      // Canonical match predictions / voting (1 user = 1 vote)
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }

      // Canonical match spectator reactions
      match /reactions/{uid} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }

      // Canonical match reviews
      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      }

      // Canonical player ratings for this match
      match /players/{playerId}/ratings/{uid} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }

    // Collection Group & Global Fallback Rules for Fan Engagement
    match /{path=**}/votes/{voteId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /{path=**}/reactions/{reactionId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /{path=**}/ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Legacy transitional compatibility paths
    match /match_voting/{matchId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    match /match_reactions/{matchId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
